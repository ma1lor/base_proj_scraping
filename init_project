#!/usr/bin/env bash
set -Eeuo pipefail

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

usage() {
    printf 'Usage: init_project [DIRECTORY]\n'
    printf 'Create an async Python project in a new or empty directory.\n'
    printf 'Without DIRECTORY, use the current directory.\n'
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi
[[ $# -le 1 ]] || fail "Expected at most one directory argument."

for command in uv git; do
    command -v "$command" >/dev/null 2>&1 || fail "Required command not found: $command"
done

project_dir="${1:-.}"
[[ ! -e "$project_dir" || -d "$project_dir" ]] || fail "Destination is not a directory."

if [[ -d "$project_dir" ]]; then
    project_dir=$(cd -- "$project_dir" && pwd -P)
    shopt -s nullglob dotglob
    for entry in "$project_dir"/*; do
        if [[ "${entry##*/}" == ".git" && -d "$entry" ]]; then
            continue
        fi
        fail "Destination must be empty (an existing .git directory is allowed)."
    done
    shopt -u nullglob dotglob
fi

project_name=$(basename -- "$project_dir")
project_name=$(printf '%s' "$project_name" | LC_ALL=C tr '[:upper:]' '[:lower:]' | tr ' -' '__')
[[ "$project_name" =~ ^[a-z][a-z0-9_]*$ ]] || fail "Project name must start with a letter and contain only letters, digits, underscores, spaces or hyphens."
[[ ${#project_name} -le 63 ]] || fail "Normalized project name must be at most 63 characters."

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
script_path="$script_dir/$(basename -- "${BASH_SOURCE[0]}")"
trap 'printf "Initialization failed near line %s. Generated files were kept for inspection.\n" "$LINENO" >&2' ERR

mkdir -p -- "$project_dir"
project_dir=$(cd -- "$project_dir" && pwd -P)
mkdir -p "$project_dir"/src/{core/db,db,services,settings,models,sql,utils,recourses,logs}

cat > "$project_dir/pyproject.toml" <<INIT_PROJECT_METADATA
[project]
name = "$project_name"
version = "0.1.0"
description = "Async Python project"
readme = "README.md"
requires-python = ">=3.13"
dependencies = [
    "curl-cffi>=0.16.3",
    "loguru>=0.7.3",
    "psycopg[binary,pool]>=3.3.6",
    "pydantic-settings>=2.15.0",
]

[tool.uv]
package = false
INIT_PROJECT_METADATA

